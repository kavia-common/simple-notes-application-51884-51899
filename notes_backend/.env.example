# Backend runtime configuration (example)
# Copy to .env and adjust as needed.

# PUBLIC URL of backend (used in docs/links)
BACKEND_URL=http://localhost:3001

# URL for frontend allowed by CORS
FRONTEND_URL=http://localhost:3000
SITE_URL=http://localhost:3000

# CORS configuration (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000
ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With
ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS

# Server bind
HOST=0.0.0.0
PORT=3001

# SQLite database file path used by notes backend.
# In this workspace, the SQLite container keeps the DB at:
#   /home/kavia/workspace/code-generation/simple-notes-application-51884-51901/database/myapp.db
#
# For a monorepo, prefer a relative path like: ../database/myapp.db
SQLITE_DB_PATH=../database/myapp.db
